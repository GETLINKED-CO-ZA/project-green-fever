# ---- Required ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-only secret. Never expose to the browser.
RESEND_API_KEY=                       # server-only secret
PGF_FROM_EMAIL="Project Green Fever <reports@your-verified-domain.example>"
PGF_ADMIN_EMAIL=                      # where Email A is delivered
IP_HASH_SALT=                         # long random string (e.g. `openssl rand -hex 32`)

# ---- Recommended ----
PGF_REVIEW_URL=                       # link behind the REVIEW REPORT button (e.g. your Supabase table editor URL)
PGF_CONTACT_EMAIL=                    # shown in the reporter confirmation; also used as Reply-To
SUPABASE_EVIDENCE_BUCKET=pgf-evidence # private bucket name

# ---- Optional ----
PGF_RATE_LIMIT_PER_HOUR=5             # reports per hashed IP per hour
TURNSTILE_SECRET=                     # enables Cloudflare Turnstile verification (also set the site key in public/index.html)
ALLOWED_ORIGINS=                      # comma-separated; only needed if the form is hosted on a different origin from the API
